<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon foreground: rupee (₹) glyph with a rising trend tick.
    Drawn with round-capped strokes, kept inside the adaptive-icon safe zone
    (66dp circle centered in the 108dp viewport). Also used as the monochrome
    layer for Android 13+ themed icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ₹ top bar -->
    <path
        android:pathData="M38,34 L68,34"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- ₹ second bar -->
    <path
        android:pathData="M38,46 L68,46"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- ₹ bowl: from top bar bulging right, closing at the stem -->
    <path
        android:pathData="M46,34 C60,34 60,58 46,58 L40,58"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- ₹ diagonal leg -->
    <path
        android:pathData="M46,58 L64,78"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
